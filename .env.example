# Private env (generated from Key.txt or written by hand).
# Do not commit this file.

DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# LLM policy (optional)
# GNOM_FREE_ONLY=0
# GNOM_MAX_BUDGET_USD=1.0

# Session packs (optional)
# GNOM_AUTO_PACK=0
# GNOM_PACK_MAX=30

# Agent dispatcher (scripts/agent_dispatch.py + scripts/run_agent.sh)
# Kill switch: GNOM_AGENT_DISPATCH=0
GNOM_AGENT_DISPATCH=1
GNOM_GITHUB_REPO=landjunge/gnom-hub-v1
# GITHUB_TOKEN=  # or GNOM_GITHUB_TOKEN — never commit the real token
GNOM_GROK_BIN=grok
GNOM_AGENT_MAX_TURNS=80
GNOM_AGENT_WORKDIR=
GNOM_BUILDER_CMD=scripts/run_agent.sh builder
GNOM_REVIEWER_CMD=scripts/run_agent.sh reviewer

# GitHub PR webhook (scripts/github_pr_webhook.py) — same secret + builder cmd.
GNOM_WEBHOOK_SECRET=replace-with-a-long-random-string
