# Copy this file to Key.txt and fill in your keys.
# On start, Gnom-Hub writes a private .env from Key.txt (if needed).
# Never commit Key.txt or .env.

# Official DeepSeek model id (API docs):
#   deepseek-v4-flash  — fast / economical (recommended)
#   deepseek-v4-pro    — higher quality
#   deepseek-chat      — legacy alias
DEEPSEEK_MODEL=deepseek-v4-flash

# System agents (Brainstorm, Memory, Flex, Coordinator) + global default
DEEPSEEK_API_KEY=sk-your-system-deepseek-key
# alias: SYSTEM=sk-...

# All workers (Worker 1–4) — optional; falls back to DEEPSEEK_API_KEY if empty
WORKER_API_KEY=sk-your-worker-deepseek-key
# alias: WORKER=sk-...

# Optional Telegram bot (set GNOM_TELEGRAM_POLL=1 to auto long-poll)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
