#!/usr/bin/env bash
# Pre-push gate — blocks push if ruff is red (CI lint parity).
# Install:  ./scripts/install_git_hooks.sh
# Skip:     git push --no-verify   (emergency only)
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "${ROOT}" ]; then
  echo "pre-push: not a git repo" >&2
  exit 1
fi
cd "$ROOT"

exec bash "$ROOT/scripts/prepush_gate.sh"
